# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose your LLM provider: openai, gemini, claude, or local
LLM_PROVIDER=openai

# Model name (provider-specific)
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Gemini: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
# Claude: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-5-haiku-20241022
# Local: llama3.2, mistral, codellama, etc. (depends on your local setup)
LLM_MODEL=gpt-4o

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.7

# Base URL for local models (e.g., Ollama, LM Studio, vLLM)
# LLM_BASE_URL=http://localhost:11434/v1

# =============================================================================
# API Keys (set the one for your chosen provider)
# =============================================================================
# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API Key
CLAUDE_API_KEY=your-claude-api-key-here

# Local model API key (optional, some servers don't require it)
# LOCAL_API_KEY=

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/npc_ecommerce
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/npc_ecommerce

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=NPC-Ecommerce-Sandbox
APP_ENV=development
DEBUG=true

# =============================================================================
# API Settings
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Streamlit Dashboard
# =============================================================================
STREAMLIT_PORT=8501

# =============================================================================
# Agent Settings
# =============================================================================
AGENT_VERBOSE=true
AGENT_MAX_ITER=15
AGENT_MAX_RPM=10
